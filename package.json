{
  "name": "dreo-cloud",
  "version": "0.1.3",
  "private": true,
  "description": "Development workspace for the unofficial @mehrwiedu/dreo-api SDK for DREO cloud devices.",
  "license": "MIT",
  "author": "mehrwiedu",
  "type": "module",
  "workspaces": [
    "packages/dreo-api"
  ],
  "scripts": {
    "typecheck:sdk": "npm run typecheck -w @mehrwiedu/dreo-api",
    "build:sdk": "npm run build -w @mehrwiedu/dreo-api",
    "typecheck:examples": "tsc -p examples/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:sdk && npm run typecheck:examples",
    "build": "npm run build:sdk",
    "check": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehrwiedu/dreo-cloud.git"
  },
  "homepage": "https://github.com/mehrwiedu/dreo-cloud#readme",
  "bugs": {
    "url": "https://github.com/mehrwiedu/dreo-cloud/issues"
  }
}
